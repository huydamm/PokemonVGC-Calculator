{
  "manifest_version": 3,
  "name": "VGC Live Calc",
  "version": "0.3.0",
  "description": "Free live damage-calc overlay for Pokemon Showdown. Unofficial fan project.",
  "icons": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "host_permissions": ["https://data.pkmn.cc/*", "https://championsbattledata.com/*"],
  "web_accessible_resources": [{ "resources": ["fonts/*"], "matches": ["*://play.pokemonshowdown.com/*"] }],
  "content_scripts": [
    {
      "matches": ["*://play.pokemonshowdown.com/*"],
      "js": ["dist/inject.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["*://play.pokemonshowdown.com/*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ]
}
